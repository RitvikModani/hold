# Copy this file to .env and fill in what you need.
# .env is gitignored and must stay that way.


# ---------------------------------------------------------------------------
# Required to have any videos at all.
#
# Used only by scripts/harvest.mjs, which runs on your machine. Deliberately
# has no VITE_ prefix, so Vite never exposes it to the browser — the app only
# ever fetches the static pool.json the harvest produces.
#
#   1. console.cloud.google.com -> new project
#   2. Enable "YouTube Data API v3"
#   3. Credentials -> Create credentials -> API key
#
# Free tier is plenty: a full harvest of 20 channels costs about 100 of the
# 10,000 daily quota units, and zero search calls.
# ---------------------------------------------------------------------------

YOUTUBE_API_KEY=paste-your-key-here


# ---------------------------------------------------------------------------
# Optional: cross-device sync. Leave both blank and the app runs on
# localStorage alone, with the sync UI hidden entirely.
#
# Unlike the key above, these two ARE bundled into the browser — that is what
# the VITE_ prefix means. Which is fine and intended: the anon key is designed
# to be public, and row-level security (supabase/schema.sql) is what actually
# protects the data.
#
#   1. Create a project at supabase.com
#   2. Run supabase/schema.sql in the SQL editor
#   3. Authentication -> Providers -> Google, and paste your Google OAuth
#      client ID and secret there
#   4. Copy the Project URL and the anon/public key below
#
# Your Google OAuth CLIENT SECRET does not belong here, or anywhere in this
# repo. It goes in the Supabase dashboard, where it stays server-side. Anything
# in a VITE_ variable is readable by anyone who opens devtools.
# ---------------------------------------------------------------------------

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
